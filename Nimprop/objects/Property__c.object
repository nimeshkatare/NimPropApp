    <allowInChatterGroups>false</allowInChatterGroups>
    <compactLayoutAssignment>SYSTEM</compactLayoutAssignment>
    <compactLayouts>
        <fullName>Property_Compact</fullName>
        <fields>Name</fields>
        <fields>City__c</fields>
        <fields>Type__c</fields>
        <fields>Status__c</fields>
        <fields>Rent__c</fields>
        <label>Property Compact</label>
    </compactLayouts>
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Rental property managed by the operations team (REMS-PM).</description>
    <enableActivities>true</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>true</enableHistory>
    <enableLicensing>false</enableLicensing>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <externalSharingModel>Private</externalSharingModel>
    <fields>
        <fullName>City__c</fullName>
        <externalId>false</externalId>
        <label>City</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Country__c</fullName>
        <externalId>false</externalId>
        <label>Country</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Current_Tenant__c</fullName>
        <deleteConstraint>SetNull</deleteConstraint>
        <label>Current Tenant</label>
        <referenceTo>Tenant__c</referenceTo>
        <relationshipLabel>Properties</relationshipLabel>
        <relationshipName>Properties</relationshipName>
        <required>false</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>Description__c</fullName>
        <label>Description</label>
        <length>32768</length>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Furnishing_Status__c</fullName>
        <label>Furnishing Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Furnished</fullName>
                    <default>false</default>
                    <label>Furnished</label>
                </value>
                <value>
                    <fullName>Semi-Furnished</fullName>
                    <default>false</default>
                    <label>Semi-Furnished</label>
                </value>
                <value>
                    <fullName>Unfurnished</fullName>
                    <default>false</default>
                    <label>Unfurnished</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Geocoding_Error__c</fullName>
        <externalId>false</externalId>
        <label>Geocoding Error</label>
        <length>255</length>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Geocoding_Status__c</fullName>
        <label>Geocoding Status</label>
        <required>false</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Pending</fullName>
                    <default>false</default>
                    <label>Pending</label>
                </value>
                <value>
                    <fullName>Success</fullName>
                    <default>false</default>
                    <label>Success</label>
                </value>
                <value>
                    <fullName>Failed</fullName>
                    <default>false</default>
                    <label>Failed</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Location__c</fullName>
        <displayLocationInDecimal>true</displayLocationInDecimal>
        <label>Location</label>
        <required>false</required>
        <scale>6</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Location</type>
    </fields>
    <fields>
        <fullName>Occupied_Flag__c</fullName>
        <description>1 when Occupied, else 0. Used by the Occupancy Rate report summary formula.</description>
        <externalId>false</externalId>
        <formula>IF(ISPICKVAL(Status__c, &quot;Occupied&quot;), 1, 0)</formula>
        <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
        <label>Occupied Flag</label>
        <precision>18</precision>
        <required>false</required>
        <scale>0</scale>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Postal_Code__c</fullName>
        <externalId>false</externalId>
        <label>Postal Code</label>
        <length>20</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Rent__c</fullName>
        <label>Rent</label>
        <precision>16</precision>
        <required>true</required>
        <scale>2</scale>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Currency</type>
    </fields>
    <fields>
        <fullName>State__c</fullName>
        <externalId>false</externalId>
        <label>State</label>
        <length>100</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Status__c</fullName>
        <label>Status</label>
        <required>true</required>
        <trackHistory>true</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Available</fullName>
                    <default>true</default>
                    <label>Available</label>
                </value>
                <value>
                    <fullName>Occupied</fullName>
                    <default>false</default>
                    <label>Occupied</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Street__c</fullName>
        <externalId>false</externalId>
        <label>Address</label>
        <length>255</length>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Type__c</fullName>
        <label>Type</label>
        <required>true</required>
        <trackHistory>false</trackHistory>
        <trackTrending>false</trackTrending>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Residential</fullName>
                    <default>false</default>
                    <label>Residential</label>
                </value>
                <value>
                    <fullName>Commercial</fullName>
                    <default>false</default>
                    <label>Commercial</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <label>Property</label>
    <listViews>
        <fullName>All</fullName>
        <columns>NAME</columns>
        <columns>City__c</columns>
        <columns>State__c</columns>
        <columns>Type__c</columns>
        <columns>Furnishing_Status__c</columns>
        <columns>Status__c</columns>
        <columns>Rent__c</columns>
        <columns>Current_Tenant__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Properties</label>
    </listViews>
    <listViews>
        <fullName>Available_Properties</fullName>
        <columns>NAME</columns>
        <columns>City__c</columns>
        <columns>Type__c</columns>
        <columns>Furnishing_Status__c</columns>
        <columns>Rent__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>Status__c</field>
            <operation>equals</operation>
            <value>Available</value>
        </filters>
        <label>Available Properties</label>
    </listViews>
    <nameField>
        <label>Property Name</label>
        <trackHistory>false</trackHistory>
        <type>Text</type>
    </nameField>
    <pluralLabel>Properties</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>City__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Type__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Status__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Rent__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>Description_Required</fullName>
        <active>true</active>
        <description>REMS-PM-001: Description is mandatory (long text areas cannot be marked required at field level).</description>
        <errorConditionFormula>ISBLANK(Description__c)</errorConditionFormula>
        <errorDisplayField>Description__c</errorDisplayField>
        <errorMessage>Description is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Rent_Must_Be_Positive</fullName>
        <active>true</active>
        <errorConditionFormula>Rent__c &lt;= 0</errorConditionFormula>
        <errorDisplayField>Rent__c</errorDisplayField>
        <errorMessage>Rent must be greater than zero.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
