<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configuration for the address geocoding integration. Endpoint host lives in the Named Credential; provider-specific path and headers live here.</description>
    <fields>
        <fullName>Active__c</fullName>
        <defaultValue>true</defaultValue>
        <description>Uncheck to disable automatic geocoding.</description>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Active</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Batch_Size__c</fullName>
        <description>Maximum properties geocoded per queueable execution (callout governor limit is 100).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Batch Size</label>
        <precision>3</precision>
        <required>false</required>
        <scale>0</scale>
        <type>Number</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Named_Credential__c</fullName>
        <description>Developer name of the Named Credential that holds the geocoding host.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Named Credential</label>
        <length>80</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Search_Path__c</fullName>
        <description>Path and fixed query parameters appended to the Named Credential. The URL-encoded address is appended at the end.</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>Search Path</label>
        <length>255</length>
        <required>true</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>User_Agent__c</fullName>
        <description>User-Agent header value (required by Nominatim usage policy).</description>
        <externalId>false</externalId>
        <fieldManageability>DeveloperControlled</fieldManageability>
        <label>User Agent</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <label>Geocoding Setting</label>
    <pluralLabel>Geocoding Settings</pluralLabel>
    <visibility>Public</visibility>
</CustomObject>
