        <columns>Days_To_Expiry__c</columns>
        <filterScope>Everything</filterScope>
        <label>All Lease Agreements</label>
    </listViews>
    <listViews>
        <fullName>Expiring_Next_30_Days</fullName>
        <columns>NAME</columns>
        <columns>Property__c</columns>
        <columns>Tenant__c</columns>
        <columns>End_Date__c</columns>
        <columns>Days_To_Expiry__c</columns>
        <columns>Reminder_30_Day_Sent__c</columns>
        <filterScope>Everything</filterScope>
        <filters>
            <field>End_Date__c</field>
            <operation>equals</operation>
            <value>NEXT_N_DAYS:30</value>
        </filters>
        <label>Expiring Next 30 Days</label>
    </listViews>
    <nameField>
        <displayFormat>LA-{00000}</displayFormat>
        <label>Lease Agreement Number</label>
        <trackHistory>false</trackHistory>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Lease Agreements</pluralLabel>
    <searchLayouts>
        <searchResultsAdditionalFields>Property__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>Tenant__c</searchResultsAdditionalFields>
        <searchResultsAdditionalFields>End_Date__c</searchResultsAdditionalFields>
    </searchLayouts>
    <sharingModel>Private</sharingModel>
    <validationRules>
        <fullName>End_Date_After_Start</fullName>
        <active>true</active>
        <errorConditionFormula>End_Date__c &lt;= Start_Date__c</errorConditionFormula>
        <errorDisplayField>End_Date__c</errorDisplayField>
        <errorMessage>End Date must be after Start Date.</errorMessage>
    </validationRules>
    <visibility>Public</visibility>
</CustomObject>
