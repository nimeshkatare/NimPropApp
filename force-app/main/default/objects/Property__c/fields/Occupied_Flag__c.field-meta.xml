<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Occupied_Flag__c</fullName>
    <description>1 when Occupied, else 0. Used by the Occupancy Rate report summary formula.</description>
    <externalId>false</externalId>
    <formula>IF(ISPICKVAL(Status__c, &quot;Occupied&quot;), 1, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Occupied Flag</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
